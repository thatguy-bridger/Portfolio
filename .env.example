# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and never committed. See SETUP.md for where each value comes
# from and how to set the server-only ones in Vercel's dashboard.

# Firebase client config (Project settings -> General -> Your apps -> Web
# app). Not secret — this is meant to ship in the browser bundle; Firebase's
# actual security boundary is Auth + your rules, not hiding this config.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Server-only secrets — never prefix these with PUBLIC_, never commit real
# values, and set them in Vercel's dashboard (not just locally).
# The Firebase Admin service account, as a single-line JSON string (Project
# settings -> Service accounts -> Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Supabase project URL and service-role key (Project Settings -> API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
