---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LoginForm } from '../../components/admin/LoginForm';

// Already signed in? Skip straight to the dashboard instead of showing the form again.
if (Astro.locals.admin) return Astro.redirect('/admin');
---

<BaseLayout title="Sign in — Portfolio">
  <main style="max-width: 400px; margin: 80px auto; padding: 0 20px;">
    <h1>Sign in</h1>
    <LoginForm client:load />
  </main>
</BaseLayout>
