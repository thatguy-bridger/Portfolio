---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PagesManager } from '../../../components/admin/PagesManager';
---

<BaseLayout title="Pages — Admin — Portfolio">
  <main style="max-width: 880px; margin: 0 auto; padding: 48px 20px 96px; display: flex; flex-direction: column; gap: var(--space-6);">
    <div>
      <a href="/admin" style="font-size: 12px; color: var(--text-muted);">&larr; Admin</a>
      <h1 style="font-size: var(--text-3xl); color: var(--text-heading); margin-top: 4px;">Pages</h1>
    </div>
    <PagesManager client:load />
  </main>
</BaseLayout>

<style>
  main :global(button:not(.btn)) {
    font-family: var(--font-body);
  }
</style>
