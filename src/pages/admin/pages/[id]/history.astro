---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { HistoryPanel } from '../../../../components/admin/HistoryPanel';
import { getSupabase } from '../../../../lib/supabase-server';

// Middleware already guarantees Astro.locals.admin here (see middleware.ts).
const { id } = Astro.params;

let page: { id: string; title: string; path: string } | null = null;
let loadError: string | null = null;
try {
  const { data, error } = await getSupabase().from('pages').select('id, title, path').eq('id', id).maybeSingle();
  if (error) loadError = error.message;
  else page = data;
} catch (err) {
  loadError = err instanceof Error ? err.message : 'Could not reach Supabase.';
}

if (!page && !loadError) return new Response(null, { status: 404 });
---

<BaseLayout title={page ? `History — ${page.title} — Admin — Portfolio` : 'Admin — Portfolio'}>
  <main style="max-width: 880px; margin: 0 auto; padding: 24px 20px 96px; display: flex; flex-direction: column; gap: var(--space-6);">
    {loadError ? (
      <p style="color: #ef4444;">Could not load this page: {loadError}</p>
    ) : page ? (
      <>
        <div>
          <a href={`/admin/pages/${page.id}`} style="font-size: 12px; color: var(--text-muted);">&larr; Back to editor</a>
          <h1 style="font-size: var(--text-3xl); color: var(--text-heading); margin-top: 4px;">History — {page.title}</h1>
          <p style="color: var(--text-muted); font-size: var(--text-sm); margin-top: 2px;">
            {page.path} · every draft save and publish, newest first. Expand one to see what changed; roll the live site back to any past publish.
          </p>
        </div>
        <HistoryPanel pageId={page.id} client:load />
      </>
    ) : null}
  </main>
</BaseLayout>
