---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SignOutButton } from '../../components/admin/SignOutButton';
import { ThemeToggle } from '../../components/ThemeToggle';
import { ThemeSettingsPanel } from '../../components/ThemeSettingsPanel';
import { getSupabase } from '../../lib/supabase-server';

// Middleware already redirects signed-out visitors to /admin/login before
// this ever renders — Astro.locals.admin is guaranteed non-null here.
const admin = Astro.locals.admin!;

// A first, minimal connectivity check — this becomes the real Diagnostics
// screen in Phase 5. For now it just proves the Supabase env vars are wired
// correctly, since that can't be verified by a build/typecheck alone.
let supabaseStatus: { ok: boolean; detail: string };
try {
  const { error, count } = await getSupabase().from('pages').select('*', { count: 'exact', head: true });
  supabaseStatus = error ? { ok: false, detail: error.message } : { ok: true, detail: `Connected — ${count ?? 0} page(s) in the database.` };
} catch (err) {
  supabaseStatus = { ok: false, detail: err instanceof Error ? err.message : 'Unknown error' };
}
---

<BaseLayout title="Admin — Portfolio">
  <main style="max-width: 720px; margin: 0 auto; padding: 48px 20px 96px; display: flex; flex-direction: column; gap: var(--space-6);">
    <header style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;">
      <div>
        <h1 style="font-size: var(--text-3xl); color: var(--text-heading);">Admin</h1>
        <p style="color: var(--text-muted); font-size: var(--text-sm);">Signed in as {admin.email ?? admin.uid}.</p>
      </div>
      <ThemeToggle client:load />
    </header>

    <section class="card" style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
      <p style="margin: 0; color: var(--text-body); font-size: var(--text-sm);">
        Supabase: {supabaseStatus.ok ? '✅' : '❌'} {supabaseStatus.detail}
      </p>
      <SignOutButton client:load />
    </section>

    <section>
      <h2 style="font-size: var(--text-xl); color: var(--text-heading); margin-bottom: var(--space-3);">Theme</h2>
      <ThemeSettingsPanel client:load />
    </section>
  </main>
</BaseLayout>

<style>
  main :global(button:not(.btn)) {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-default);
    background: var(--surface-panel);
    color: var(--text-heading);
    padding: 0.5em 1.2em;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }
  main :global(button:not(.btn):hover) {
    border-color: var(--border-strong);
  }
</style>
