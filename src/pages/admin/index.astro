---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SignOutButton } from '../../components/admin/SignOutButton';
import { ThemeToggle } from '../../components/ThemeToggle';
import { ThemeSettingsPanel } from '../../components/ThemeSettingsPanel';
import { runDiagnostics } from '../../lib/diagnostics';
import { getOrCreateHomepage } from '../../lib/pages';

// Middleware already redirects signed-out visitors to /admin/login before
// this ever renders — Astro.locals.admin is guaranteed non-null here.
const admin = Astro.locals.admin!;

// Phase 4 had a one-off inline Supabase-connectivity check here ("this
// becomes the real Diagnostics screen in Phase 5"). It now IS that screen —
// this dashboard just shows a one-line overall pass/fail pulled from the
// same shared checks (src/lib/diagnostics.ts) and links to the full
// per-check breakdown at /admin/diagnostics.
const checks = await runDiagnostics(admin);
const allOk = checks.every((c) => c.ok);
const failing = checks.filter((c) => !c.ok);

// The homepage (portfolio.bridgerjones.com, path "/") is just a normal row
// in `pages` like any other — nothing special about it structurally — but
// there's otherwise no obvious way to reach it from admin without already
// knowing to create a page at the exact path "/" via the generic form. This
// gets-or-creates that row so a "Homepage" shortcut always has somewhere to
// link straight into the canvas editor.
const homepageId = await getOrCreateHomepage();
---

<BaseLayout title="Admin — Portfolio">
  <main style="max-width: 720px; margin: 0 auto; padding: 48px 20px 96px; display: flex; flex-direction: column; gap: var(--space-6);">
    <header style="display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;">
      <div>
        <h1 style="font-size: var(--text-3xl); color: var(--text-heading);">Admin</h1>
        <p style="color: var(--text-muted); font-size: var(--text-sm);">Signed in as {admin.email ?? admin.uid}.</p>
      </div>
      <ThemeToggle client:load />
    </header>

    <section class="card" style="display: flex; align-items: center; justify-content: space-between; gap: 16px;">
      <p style="margin: 0; color: var(--text-body); font-size: var(--text-sm);">
        {allOk ? '✅ All diagnostics passing.' : `❌ ${failing.length} diagnostic check(s) failing.`}
        {' '}<a href="/admin/diagnostics" style="color: var(--accent-primary);">View diagnostics &rarr;</a>
      </p>
      <SignOutButton client:load />
    </section>

    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-3);">
      <a class="card" href={`/admin/pages/${homepageId}`} style="text-decoration: none; color: inherit;">
        <h3 style="font-size: var(--text-lg); color: var(--text-heading); margin-bottom: 4px;">Homepage</h3>
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">Edit portfolio.bridgerjones.com.</p>
      </a>
      <a class="card" href="/admin/pages" style="text-decoration: none; color: inherit;">
        <h3 style="font-size: var(--text-lg); color: var(--text-heading); margin-bottom: 4px;">Pages</h3>
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">Edit content, draft &amp; publish.</p>
      </a>
      <a class="card" href="/admin/inbox" style="text-decoration: none; color: inherit;">
        <h3 style="font-size: var(--text-lg); color: var(--text-heading); margin-bottom: 4px;">Inbox</h3>
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">Contact-form submissions.</p>
      </a>
      <a class="card" href="/admin/media" style="text-decoration: none; color: inherit;">
        <h3 style="font-size: var(--text-lg); color: var(--text-heading); margin-bottom: 4px;">Media library</h3>
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">Uploaded images.</p>
      </a>
      <a class="card" href="/admin/diagnostics" style="text-decoration: none; color: inherit;">
        <h3 style="font-size: var(--text-lg); color: var(--text-heading); margin-bottom: 4px;">Diagnostics</h3>
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">Connectivity &amp; health checks.</p>
      </a>
    </section>

    <section>
      <h2 style="font-size: var(--text-xl); color: var(--text-heading); margin-bottom: var(--space-3);">Theme</h2>
      <ThemeSettingsPanel client:load />
    </section>
  </main>
</BaseLayout>

<style>
  main :global(button:not(.btn)) {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-default);
    background: var(--surface-panel);
    color: var(--text-heading);
    padding: 0.5em 1.2em;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }
  main :global(button:not(.btn):hover) {
    border-color: var(--border-strong);
  }
</style>
