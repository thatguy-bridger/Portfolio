---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { InboxManager } from '../../components/admin/InboxManager';
---

<BaseLayout title="Inbox — Admin — Portfolio">
  <main style="max-width: 880px; margin: 0 auto; padding: 48px 20px 96px; display: flex; flex-direction: column; gap: var(--space-6);">
    <div>
      <a href="/admin" style="font-size: 12px; color: var(--text-muted);">&larr; Admin</a>
      <h1 style="font-size: var(--text-3xl); color: var(--text-heading); margin-top: 4px;">Inbox</h1>
    </div>
    <InboxManager client:load />
  </main>
</BaseLayout>
