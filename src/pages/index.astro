---
// The real homepage — Phase 4 wires this to Supabase, same as every other
// page (src/pages/[...path].astro), for the same reason that file exists:
// a static route like this one always wins over the "[...path]" catch-all
// in Astro's routing priority, so "/" needs its own copy of the same
// fetch-and-render logic rather than ever reaching the catch-all. See
// src/lib/publicPage.ts for the shared lookup both files call. (The old
// design-system placeholder that used to live at this path moved to
// src/pages/dev/theme-demo.astro — see that file's header comment.)
import BaseLayout from '../layouts/BaseLayout.astro';
import { PublicPage } from '../components/render/PublicPage';
import { fetchPublishedPage } from '../lib/publicPage';

const page = await fetchPublishedPage('/');
if (!page) Astro.response.status = 404;
---

{page ? (
  <BaseLayout title={`${page.title} — Portfolio`}>
    <PublicPage sections={page.blocks} client:load />
  </BaseLayout>
) : (
  <BaseLayout title="Bridger Jones">
    <main style="max-width: 480px; margin: 96px auto; padding: 0 20px; text-align: center;">
      <h1 style="font-size: var(--text-3xl); color: var(--text-heading);">Nothing published yet</h1>
      <p style="color: var(--text-muted);">Sign in at /admin, create a page at path "/", and hit Publish.</p>
    </main>
  </BaseLayout>
)}
