rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The working draft — only the signed-in owner can read or write it.
    // (There's only one account in this project, so "signed in" == "owner".)
    match /sites/draft {
      allow read, write: if request.auth != null;
    }

    // The live, published site — publicly readable, only the owner can write.
    match /sites/published {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // One snapshot per publish, for rollback — owner-only, never public. The
    // client caps how many it keeps (see MAX_VERSIONS in firebase/site.ts);
    // this doesn't enforce that cap itself, just who can read/write.
    match /siteVersions/{versionId} {
      allow read, write: if request.auth != null;
    }

    // Contact form submissions — anyone can send one (validated shape, capped
    // length, no extra fields), but only the owner can read the inbox, mark
    // messages read, or delete them. There's no server here, so this is the
    // spam backstop; a client-side honeypot field catches basic bots too.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'read'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000
        && request.resource.data.read == false;
      allow read, update, delete: if request.auth != null;
    }
  }
}
