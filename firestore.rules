rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The working draft — only the signed-in owner can read or write it.
    // (There's only one account in this project, so "signed in" == "owner".)
    match /sites/draft {
      allow read, write: if request.auth != null;
    }

    // The live, published site — publicly readable, only the owner can write.
    match /sites/published {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
