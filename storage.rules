rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // 3D models (.glb/.gltf/.obj/.fbx/.stl/.ply) — these formats don't have a
    // standard image/* MIME type and browsers report them inconsistently, so
    // this only caps size; the app itself validates the file extension
    // before upload.
    match /models/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024;
    }
    match /videos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
